{
  "type": "module",
  "name": "full-stack-template-client",
  "scripts": {
    "install:clean": "rm -rf node_modules && npm install",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "format:check": "oxfmt --check",
    "format:write": "oxfmt",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest watch",
    "test:unit:coverage": "vitest run --coverage",
    "verify": "npm-run-all generate translations:validate verify:static build:verify",
    "verify:static": "npm-run-all -p lint typecheck format:check test:unit",
    "prestart": "npm run generate",
    "prebuild": "NODE_ENV=production npm run generate",
    "start": "vite",
    "build": "vite build",
    "build:verify": "NODE_ENV=production vite build",
    "preview": "vite preview",
    "analyze": "ANALYZE=true npm run build",
    "translations:extract": "lingui extract --clean",
    "translations:validate": "npm run translations:extract && lingui compile --strict --typescript",
    "uikit:preview": "storybook dev -p 6006",
    "uikit:build": "storybook build",
    "design-system:sync": "npm-run-all -s design-system:tokenize design-system:codegen design-system:format",
    "design-system:tokenize": "figmage tokenize --env ./src/design-system/.env",
    "design-system:codegen": "figmage codegen --env ./src/design-system/.env",
    "design-system:format": "oxfmt --write \"src/design-system/tokens/*.ts\"",
    "generate": "npm-run-all -p generate:*",
    "generate:graphql": "gql-tada generate-output",
    "generate:design-system": "panda codegen --clean"
  },
  "dependencies": {
    "@apollo/client": "4.3.0",
    "@internationalized/date": "3.12.4",
    "@lingui/react": "6.7.0",
    "@loadable/component": "5.16.7",
    "@sentry/browser": "10.74.0",
    "@tanstack/react-router": "1.170.35",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/zod-adapter": "1.167.0",
    "@wry/equality": "0.5.7",
    "date-fns": "4.4.0",
    "es-toolkit": "1.52.0",
    "gql.tada": "1.11.3",
    "graphql": "17.0.2",
    "react": "19.3.0",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-merge-refs": "3.0.2",
    "react-stately": "3.50.0",
    "react-use-measure": "2.1.7",
    "rxjs": "7.8.2",
    "sonner": "2.0.8",
    "spin-delay": "2.0.1",
    "zod": "4.6.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "8.0.5",
    "@lingui/babel-plugin-lingui-macro": "6.7.0",
    "@lingui/cli": "6.7.0",
    "@lingui/format-po": "6.7.0",
    "@lingui/vite-plugin": "6.7.0",
    "@pandacss/dev": "1.12.1",
    "@peterek/vite-plugin-favicons": "2.1.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/tanstack-react": "10.6.0",
    "@tanstack/router-plugin": "1.168.37",
    "@tanstack/virtual-file-routes": "1.162.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/loadable__component": "5.13.10",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-lingui": "0.15.0",
    "eslint-plugin-react-dom": "5.19.0",
    "eslint-plugin-react-hooks-extra": "2.13.0",
    "eslint-plugin-react-jsx": "5.19.0",
    "eslint-plugin-react-naming-convention": "5.19.0",
    "eslint-plugin-react-web-api": "5.19.0",
    "eslint-plugin-react-x": "5.19.0",
    "figmage": "2.1.3",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "npm-run-all": "4.1.5",
    "oxc-transform-react": "0.149.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "rollup-plugin-visualizer": "7.1.1",
    "storybook": "10.6.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.0",
    "vite-plugin-splash-screen": "0.2.2",
    "vite-plugin-watch-and-run": "1.8.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  }
}
