{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "target": "esnext",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "strict": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals"],
    "paths": {
      "~/design-system/*": ["./src/design-system/generated/*"],
      "~/graphql": ["./src/graphql/index.ts"],
      "~/uikit/*": ["./src/components/uikit/*"],
      "~/design-tokens/*": ["./src/design-system/tokens/*"],
      "~/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "gql.tada/ts-plugin",
        "schema": "./shared/schema.gql",
        "tadaOutputLocation": "./src/graphql/generated.d.ts"
      }
    ]
  },
  "include": ["shared", "src", ".storybook"],
  "exclude": ["node_modules", "assets", "build", "test", "__mocks__"]
}
