{
  "type": "module",
  "name": "full-stack-template-server",
  "scripts": {
    "start": "npm run start:dev",
    "start:dev": "NODE_ENV=development tsx watch index.ts --inspect=0.0.0.0:9229 | bunyan -o short -l debug",
    "start:prod": "NODE_ENV=production npm run build && node --enable-source-maps ../build/index.js",
    "build": "NODE_ENV=production esbuild index.ts db/migrate.ts db/seed.ts --bundle --platform=node --format=esm --packages=external --target=node22 --sourcemap --outbase=. --outdir=../build",
    "test:unit": "MODE=unit vitest run",
    "test:unit:watch": "MODE=unit vitest watch",
    "test:unit:update": "vitest run --update",
    "test:integration": "MODE=integration vitest run",
    "test:api": "MODE=api vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "format:check": "oxfmt --check './src/**/*.{ts,tsx}'",
    "format:write": "oxfmt './src/**/*.{ts,tsx}'",
    "db:migrate": "tsx ./db/migrate.ts",
    "db:migrate:ci": "node --enable-source-maps ./db/migrate.js",
    "db:migrate:drop": "drizzle-kit drop",
    "db:migrate:generate": "drizzle-kit generate",
    "db:seed": "tsx ./db/seed/index.ts",
    "db:seed:ci": "node --enable-source-maps ./db/seed.js",
    "generate": "npm-run-all -p generate:*",
    "generate:graphql": "gql.tada generate output",
    "graphql:check": "gql.tada check"
  },
  "dependencies": {
    "@apollo/server": "4.11.0",
    "@as-integrations/fastify": "2.1.1",
    "@aws-sdk/client-s3": "3.637.0",
    "@aws-sdk/client-secrets-manager": "3.637.0",
    "@aws-sdk/s3-request-presigner": "3.637.0",
    "@escape.tech/graphql-armor": "3.0.1",
    "@fastify/cookie": "9.4.0",
    "@fastify/multipart": "8.3.0",
    "@fastify/type-provider-typebox": "4.1.0",
    "@node-rs/argon2": "1.8.3",
    "@pothos/core": "4.2.0",
    "@pothos/plugin-scope-auth": "4.1.0",
    "@pothos/plugin-simple-objects": "4.1.0",
    "@sentry/node": "8.26.0",
    "@sinclair/typebox": "0.33.7",
    "bunyan": "1.8.15",
    "drizzle-orm": "0.33.0",
    "fastify": "4.28.1",
    "fastify-plugin": "4.5.1",
    "graphql": "16.9.0",
    "graphql-scalars": "1.23.0",
    "graphql-ws": "5.16.0",
    "ky": "1.7.1",
    "pg": "8.22.0",
    "query-string": "9.1.0",
    "uuid": "10.0.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/bunyan": "1.8.11",
    "@types/node": "22.5.0",
    "@types/pg": "8.11.6",
    "@types/uuid": "10.0.0",
    "@types/ws": "8.5.12",
    "drizzle-kit": "0.24.0",
    "esbuild": "0.28.1",
    "gql.tada": "1.11.3",
    "graphql-request": "6.1.0",
    "npm-run-all": "4.1.5",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "4.17.0",
    "typescript": "7.0.2",
    "vitest": "3.0.3"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
