{
  "type": "module",
  "name": "full-stack-template-server",
  "scripts": {
    "start": "npm run start:dev",
    "start:dev": "NODE_ENV=development tsx watch index.ts --inspect=0.0.0.0:9229",
    "start:prod": "NODE_ENV=production npm run build && node --enable-source-maps ../build/index.js",
    "build": "NODE_ENV=production esbuild index.ts db/migrate.ts db/seed.ts --bundle --platform=node --format=esm --packages=external --target=node24.19.0 --sourcemap --outbase=. --outdir=../build",
    "test:unit": "MODE=unit vitest run",
    "test:unit:watch": "MODE=unit vitest watch",
    "test:unit:update": "vitest run --update",
    "test:integration": "MODE=integration node --import tsx ./test/run/run-tests.ts",
    "test:api": "MODE=api node --import tsx ./test/run/run-tests.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "format:check": "oxfmt --check",
    "format:write": "oxfmt",
    "verify": "npm-run-all generate verify:static build",
    "verify:static": "npm-run-all -p lint typecheck format:check",
    "db:migrate": "tsx ./db/migrate.ts",
    "db:migrate:ci": "node --enable-source-maps ./db/migrate.js",
    "db:migrate:drop": "drizzle-kit drop",
    "db:migrate:generate": "drizzle-kit generate",
    "db:seed": "tsx ./db/seed.ts",
    "db:seed:ci": "node --enable-source-maps ./db/seed.js",
    "generate": "npm-run-all -p generate:*",
    "generate:graphql": "gql.tada generate output",
    "graphql:check": "gql.tada check"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/fastify": "3.1.0",
    "@aws-sdk/client-s3": "3.1130.0",
    "@aws-sdk/client-secrets-manager": "3.1130.0",
    "@aws-sdk/s3-request-presigner": "3.1130.0",
    "@escape.tech/graphql-armor": "3.2.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "@node-rs/argon2": "2.2.1",
    "@pothos/core": "4.14.0",
    "@pothos/plugin-scope-auth": "4.1.7",
    "@pothos/plugin-simple-objects": "4.1.4",
    "@sentry/node": "10.74.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.4",
    "fastify-plugin": "6.0.0",
    "graphql": "16.11.0",
    "graphql-scalars": "2.0.0",
    "graphql-ws": "6.2.1",
    "ky": "2.1.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "query-string": "9.5.1",
    "typebox": "1.3.30",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "gql.tada": "1.11.3",
    "graphql-request": "7.4.0",
    "npm-run-all": "4.1.5",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  }
}
